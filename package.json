{
  "name": "catchtwo",
  "version": "2.0.0-beta.1",
  "description": "AI-based PokéTwo autocatcher; efficient, low-detection & flawless catching",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyan0045/catchtwo.git"
  },
  "keywords": [
    "catchtwo",
    "autocatcher",
    "poketwo-selfbot",
    "selfbot"
  ],
  "homepage": "https://github.com/kyan0045/catchtwo#readme",
  "bugs": {
    "url": "https://github.com/kyan0045/catchtwo/issues"
  },
  "scripts": {
    "start": "node --no-deprecation index.js",
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "git-setup": "git init && git remote add origin https://github.com/kyan0045/catchtwo.git || git remote set-url origin https://github.com/kyan0045/catchtwo.git",
    "update": "git fetch origin && git pull origin main --ff-only && npm install",
    "force-update": "git fetch origin && git reset --hard origin/main && npm install",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "kyan0045",
  "license": "SEE LICENSE IN ./LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.18.1",
    "chalk": "^4.1.0",
    "date-and-time": "^3.1.1",
    "discord-self-lite": "^0.2.0",
    "figlet": "^1.8.0",
    "fs-extra": "^11.2.0",
    "gradient-string": "^3.0.0",
    "pokehint": "^1.4.26",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
